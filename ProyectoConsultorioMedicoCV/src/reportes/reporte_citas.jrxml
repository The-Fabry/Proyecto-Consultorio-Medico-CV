					<font fontName="Segoe UI" size="18" isBold="true"/>
				</textElement>
				<text><![CDATA[SMARTMED - CONSULTORIO MÉDICO]]></text>
			</staticText>
			<staticText>
				<reportElement x="15" y="38" width="350" height="18" forecolor="#93C5FD" uuid="ab61427a-8f0a-4a25-a1c1-4c759550b1d3"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Segoe UI" size="11" isBold="false" isItalic="true"/>
				</textElement>
				<text><![CDATA[Reporte General de Agenda de Citas Médicas]]></text>
			</staticText>
			<textField pattern="dd/MM/yyyy HH:mm">
				<reportElement x="375" y="24" width="165" height="20" forecolor="#FFFFFF" uuid="bb61427a-8f0a-4a25-a1c1-4c759550b1d4"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="Segoe UI" size="9"/>
				</textElement>
				<textFieldExpression><![CDATA["Emisión: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
			</textField>
		</band>
