	<detail>
		<band height="22" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="40" height="20" uuid="3c61427a-8f0a-4a25-a1c1-4c759550b1dc"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Segoe UI" size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[String.valueOf($F{id_cita})]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="40" y="0" width="120" height="20" uuid="4c61427a-8f0a-4a25-a1c1-4c759550b1dd"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Segoe UI" size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[" " + $F{paciente}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="160" y="0" width="70" height="20" uuid="5c61427a-8f0a-4a25-a1c1-4c759550b1de"/>
