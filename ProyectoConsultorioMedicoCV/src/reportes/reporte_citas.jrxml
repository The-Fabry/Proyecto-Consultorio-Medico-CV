				</textElement>
				<textFieldExpression><![CDATA[" " + $F{medico} + " (" + $F{especialidad} + ")"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="360" y="0" width="110" height="20" uuid="7c61427a-8f0a-4a25-a1c1-4c759550b1e0"/>
